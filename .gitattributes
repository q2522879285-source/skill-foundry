# 统一换行符，避免跨平台协作时满屏 "LF will be replaced by CRLF" 警告
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.glb binary
*.woff binary
*.woff2 binary

# 生成物：让 git 把 lock 文件当普通文本（但不参与 diff 统计）
package-lock.json -diff linguist-generated
